{
  "version": 1,
  "enabled": true,
  "require_change_for_meaningful_files": true,
  "meaningful_paths": [
    "src/",
    "tests/",
    "site/",
    ".github/",
    "Cargo.toml",
    "Cargo.lock",
    "action.yml",
    "package.json",
    "bun.lock",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "Package.swift",
    "Package.resolved",
    "go.mod",
    "go.sum",
    "pyproject.toml",
    "uv.lock",
    "requirements.txt",
    ".specsync/sdd.json",
    ".specsync/config.toml",
    ".specsync/config.json",
    ".specsync/version",
    "bin/"
  ],
  "ignored_paths": [
    ".specsync/",
    "specs/"
  ],
  "verification_commands": [
    "bash -n bin/fledge-weather && shellcheck bin/fledge-weather && bash bin/fledge-weather --help && bash bin/fledge-weather --version && grep -q 'binary = \"bin/fledge-weather\"' plugin.toml"
  ],
  "custom_artifacts": {},
  "principles_file": null
}
